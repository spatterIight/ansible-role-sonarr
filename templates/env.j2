PUID={{ sonarr_uid }}
PGID={{ sonarr_gid }}
TZ={{ sonarr_timezone }}

{# Sonarr takes its listening port from `<Port>` in /config/config.xml, which this role does
   not manage. Without this variable, `sonarr_container_http_port` would only relabel a port
   the application never moved to: the Traefik service label and the published port would
   point at a port nothing listens on. `SONARR__SERVER__PORT` is Sonarr's own environment
   override for that setting and takes precedence over config.xml. #}
SONARR__SERVER__PORT={{ sonarr_container_http_port }}

